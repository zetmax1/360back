# ─── Database ────────────────────────────────────────────────────────────────
# Full async-compatible PostgreSQL DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://tour360:secret@localhost:5432/tour360

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY=changeme_at_least_64_characters_long_random_string_here_replace_me_now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@admin.uz
ADMIN_PASSWORD=change_this_admin_password

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=80
# Comma-separated list
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Width x Height for thumbnail (equirectangular 2:1 ratio)
THUMBNAIL_WIDTH=512
THUMBNAIL_HEIGHT=256

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Application ─────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
# Used as the public base URL for serving uploaded files
BASE_URL=http://localhost:8000
